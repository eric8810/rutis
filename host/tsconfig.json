{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/plugin.ts", "src/bridge.ts"]
}
