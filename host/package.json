{
  "name": "rutis-bridge",
  "description": "TS-side bridge plugin for the rutis dsh bridge: llm adapter across to Rust (aimux) + event forwarding, as a dsh profile bundle; ships the rutis-dsh runner via platform packages",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/plugin.js",
  "types": "lib/types/plugin.d.ts",
  "bin": {
    "rutis-bridge": "bin/rutis-bridge.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "esbuild src/plugin.ts --bundle --format=esm --platform=node --outfile=lib/plugin.js --external:@deepseek-ai/* && tsc",
    "acceptance": "node --import tsx src/main.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}