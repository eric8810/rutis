{
  "name": "rutis-bridge",
  "description": "TS-side bridge plugin for the rutis dsh bridge: llm adapter across to Rust (aimux) + event forwarding, as a dsh profile bundle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/plugin.js",
  "exports": {
    ".": "./src/plugin.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "acceptance": "node --import tsx src/main.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "tsx": "^4.20.0"
  }
}
